{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Shared Renovate preset for all maxmorhardt repos",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":dependencyDashboard",
    "helpers:pinGitHubActionDigests"
  ],
  "timezone": "America/New_York",
  "labels": [
    "dependencies"
  ],
  "reviewers": [
    "maxmorhardt"
  ],
  "prConcurrentLimit": 5,
  "minimumReleaseAge": "3 days",
  "postUpdateOptions": [
    "gomodTidy"
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 6am on the first day of the month"
    ]
  },
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "labels": [
      "security"
    ],
    "semanticCommitType": "fix"
  },
  "packageRules": [
    {
      "description": "group all non-major updates into one rolling pr per repo",
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "all non-major dependencies"
    },
    {
      "description": "base image bumps are fixes, so release-please ships them to prod",
      "matchManagers": [
        "dockerfile"
      ],
      "semanticCommitType": "fix"
    },
    {
      "description": "keep the go directive current and move it with the golang base image in one pr",
      "matchDatasources": [
        "golang-version"
      ],
      "rangeStrategy": "bump"
    },
    {
      "description": "go toolchain bumps get their own pr",
      "matchPackageNames": [
        "go",
        "golang"
      ],
      "groupName": "go"
    },
    {
      "description": "our own reusable workflows follow main, so a push there is the release",
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "maxmorhardt/workflows"
      ],
      "pinDigests": false
    }
  ]
}
